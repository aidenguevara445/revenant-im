{
  "enabled": true,
  "name": "API key leak check",
  "description": "Stops API keys from reaching the renderer, logs or git.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/**/*.ts", "src/**/*.tsx"] },
  "then": { "type": "askAgent", "prompt": "Check the edited file: API keys must never be sent to the renderer, logged, or hard-coded. Only src/main/keystore.ts and provider adapters may touch a raw key. Fix any violation." }
}
